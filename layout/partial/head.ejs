<head>
    <script>
        (function() {
            var STORAGE_KEY = 'zen-theme-mode';
            var stored = null;
            try {
                stored = localStorage.getItem(STORAGE_KEY);
            } catch (e) {
                stored = null;
            }
            var isDark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
            document.documentElement.classList.toggle('dark', isDark);
        })();
    </script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5">
    <meta name="description" content="<%= config.description %>">
    <link rel="shortcut icon" href="<%= url_for(theme.favicon) %>" type="image/x-icon" />
    <title>
        <% if (page.title) { %>
            <%= page.title %> |
        <% } %>
        <%= config.title %>
    </title>
    <%- css('css/style.min') %>
    <%- css('css/partial/atom-one-dark.min') %>
    <link rel="stylesheet" href="https://cn-font.claude-code-best.win/packages/maple-mono-cn/dist/MapleMono-CN-Regular/result.css">
    <link rel="stylesheet" href="https://cn-font.claude-code-best.win/packages/LxgwNeoZhiSong/dist/LXGWNeoZhiSong/result.css">
    <style>
        :root {
          --font-main: "LXGW Neo ZhiSong", Verdana, sans-serif;
          --font-secondary: "LXGW Neo ZhiSong", Verdana, sans-serif;
        }

        .post-content blockquote {
          border-left: 4px solid var(--border-color);
          color: var(--text-color);
          padding: 4px 0 4px 20px;
          margin: 1em 0;
          font-style: normal;
          background: var(--surface-color);
        }
        .post-content table {
          width: 100%;
          border-collapse: collapse;
          margin: 1em 0;
          font-size: 0.95em;
        }
        .post-content th, .post-content td {
          border: 1px solid var(--border-color);
          padding: 8px 12px;
          text-align: left;
        }
        .post-content th {
          background: var(--surface-color);
          font-weight: 600;
        }
        .post-content tr:nth-child(even) {
          background: var(--surface-color);
        }
        @media (max-width: 600px) {
          .post-content table { display: block; overflow-x: auto; }
        }
        /* prevent table font-size cascading into code blocks */
        .post-content figure.highlight table { font-size: inherit; }
        .post-nav {
          display: flex;
          justify-content: space-between;
          margin: 2em 0;
          padding-top: 1em;
          border-top: 1px solid var(--border-color);
          gap: 1em;
        }
        .post-nav a {
          max-width: 45%;
          color: var(--link-color);
        }
        .post-nav-next { margin-left: auto; text-align: right; }
        .pagination {
          margin: 2em 0;
          display: flex;
          justify-content: space-between;
          align-items: center;
        }
        .pagination a { color: var(--link-color); }
        .pagination a:hover { text-decoration: underline; }
        .pagination-info { color: var(--muted-text-color); font-size: 0.9em; }
        .pagination-prev { flex: 1; }
        .pagination-next { flex: 1; text-align: right; }
        .pagination .disabled { color: var(--muted-text-color); pointer-events: none; }
        @media (max-width: 480px) {
          .pagination { flex-direction: column; gap: 0.5em; text-align: center; }
          .pagination-next { text-align: center; }
        }
        code { font-size: 0.82em; font-family: "Maple Mono CN", monospace; }
        .post-content figure.highlight td.gutter pre,
        .post-content figure.highlight td.code pre,
        .post-content .highlight:not(figure) pre {
          font-size: 0.82em;
          font-family: "Maple Mono CN", monospace;
        }
    </style>
    <script src="<%- url_for('js/theme-toggle.js') %>"></script>
</head>
